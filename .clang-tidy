Checks: >
  -*,
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-trailing-comma

WarningsAsErrors: ''

HeaderFilterRegex: '.*/src/.*'
ExcludeHeaderFilterRegex: '.*/Library/Arduino15/.*'

SystemHeaders: false